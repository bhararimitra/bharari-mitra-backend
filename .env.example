# ── App ──────────────────────────────────────────────────────────
APP_NAME=BharariMitra API
APP_VERSION=1.0.0
DEBUG=false
LOG_LEVEL=INFO

# ── Database ──────────────────────────────────────────────────────
# Format: postgresql+asyncpg://user:password@host:port/dbname
DATABASE_URL=postgresql+asyncpg://bharari:CHANGE_ME@localhost:5432/bhararimitradb
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# For Docker Compose
POSTGRES_PASSWORD=CHANGE_ME

# ── Redis (optional — API works without it) ───────────────────────
REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=300

# ── Security ──────────────────────────────────────────────────────
SECRET_KEY=CHANGE_ME_USE_SECRETS_TOKEN_HEX_32
API_RATE_LIMIT=100/minute

# ── CORS ──────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
CORS_ORIGINS=["https://bhararimitra.in","http://localhost:3000"]

# ── Scheduler ─────────────────────────────────────────────────────
CRAWLER_INTERVAL_HOURS=6
CRAWLER_RUN_ON_STARTUP=true
# false = run crawlers via: python scripts/crawler_worker.py
ENABLE_API_SCHEDULER=false
# Weekly Sunday 02:00 UTC — delete jobs whose last_date is older than N days
JOB_CLEANUP_ENABLED=true
JOB_CLEANUP_RETENTION_DAYS=7
